# Shared, SoD2SE-owned native build support used by independently built products.
function(sod2_native_product KIND PRODUCT_SOURCE_ROOT)
    if(NOT SOD2SE_ROOT AND DEFINED ENV{SOD2SE_ROOT})
        set(SOD2SE_ROOT "$ENV{SOD2SE_ROOT}")
    endif()
    if(NOT SOD2SE_ROOT)
        message(FATAL_ERROR "SOD2SE_ROOT must name the locked SoD2SE source dependency")
    endif()
    set(SOD2SE_API "${SOD2SE_ROOT}/GameApi/native")
    set(SOD2SE_SHARED "${SOD2SE_ROOT}/Native/src/Shared")
    set(SOD2SE_VENDOR "${SOD2SE_ROOT}/Native/vendor")
    if(NOT EXISTS "${SOD2SE_VENDOR}/minhook/CMakeLists.txt")
        message(FATAL_ERROR "The locked SoD2SE dependency is missing Native/vendor/minhook")
    endif()
    add_subdirectory("${SOD2SE_VENDOR}/minhook" "${CMAKE_BINARY_DIR}/minhook")
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")

    if(KIND STREQUAL "Mcm")
        set(IMGUI "${SOD2SE_VENDOR}/imgui")
        add_library(SoD2McmNative SHARED
            "${PRODUCT_SOURCE_ROOT}/src/McmNative.cpp"
            "${IMGUI}/imgui.cpp" "${IMGUI}/imgui_draw.cpp" "${IMGUI}/imgui_tables.cpp" "${IMGUI}/imgui_widgets.cpp"
            "${IMGUI}/backends/imgui_impl_win32.cpp" "${IMGUI}/backends/imgui_impl_dx11.cpp")
        target_include_directories(SoD2McmNative PRIVATE "${IMGUI}" "${IMGUI}/backends")
        target_link_libraries(SoD2McmNative PRIVATE minhook d3d11 dxgi d3dcompiler user32)
        target_compile_options(SoD2McmNative PRIVATE /utf-8 /W4)
        set_target_properties(SoD2McmNative PROPERTIES OUTPUT_NAME "SoD2SE.Mcm.Native")
        add_executable(NativeSettingsTest "${PRODUCT_SOURCE_ROOT}/tests/NativeSettingsTest.cpp")
        add_executable(NativeSettingsIggyTest "${PRODUCT_SOURCE_ROOT}/tests/NativeSettingsIggyTest.cpp")
        target_link_libraries(NativeSettingsIggyTest PRIVATE minhook)
    elseif(KIND STREQUAL "MeleeSpeed")
        add_library(SoD2MeleeNative SHARED "${PRODUCT_SOURCE_ROOT}/src/MeleeNative.cpp")
        target_compile_options(SoD2MeleeNative PRIVATE /utf-8 /W4 /WX /EHa)
        target_link_libraries(SoD2MeleeNative PRIVATE minhook bcrypt)
        set_target_properties(SoD2MeleeNative PROPERTIES OUTPUT_NAME "SoD2SE.MeleeSpeed.Native")
        add_executable(MeleeNativeTest "${PRODUCT_SOURCE_ROOT}/tests/MeleeTest.cpp")
        target_link_libraries(MeleeNativeTest PRIVATE minhook bcrypt)
        target_compile_options(MeleeNativeTest PRIVATE /EHa)
    else()
        message(FATAL_ERROR "Unsupported production native product: ${KIND}")
    endif()

    get_property(SOD2_PRODUCT_TARGETS DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(SOD2_PRODUCT_TARGET IN LISTS SOD2_PRODUCT_TARGETS)
        target_include_directories(${SOD2_PRODUCT_TARGET} PRIVATE
            "${PRODUCT_SOURCE_ROOT}/src" "${PRODUCT_SOURCE_ROOT}/tests"
            "${SOD2SE_API}" "${SOD2SE_SHARED}" "${SOD2SE_SHARED}/ui"
            "${SOD2SE_VENDOR}/minhook/include")
        target_compile_features(${SOD2_PRODUCT_TARGET} PRIVATE cxx_std_17)
        target_compile_definitions(${SOD2_PRODUCT_TARGET} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE)
        if(NOT "${SOD2_PRODUCT_TARGET}" MATCHES "^SoD2")
            target_compile_options(${SOD2_PRODUCT_TARGET} PRIVATE /utf-8 /W4 /WX)
        endif()
    endforeach()
endfunction()
